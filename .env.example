# ---------- Ollama / AI ----------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# AI inference tuning (4 vCPU / 8 GB RAM target)
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=600
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT=90
OLLAMA_NUM_THREAD=2
OLLAMA_MAX_INPUT_CHARS=8000

# ---------- Upload ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---------- Database ----------
# Empty = default: sqlite:///<project>/invoices.db
# On VPS set explicitly: sqlite:////srv/voince/invoices.db
DATABASE_URL=

# ---------- Session / auth ----------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
SESSION_MAX_AGE=1209600

# ---------- OAuth — Google ----------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- OAuth — GitHub ----------
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Deployment ----------
PORT=8000
# On VPS behind HTTPS: HTTPS_ONLY=true
HTTPS_ONLY=false
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Billing (Trybit) ----------
TRYBIT_API_URL=https://api.trybit.com
TRYBIT_API_KEY=
TRYBIT_SHOP_ID=
# PEM-encoded RSA public key used to verify Postback signatures.
# Ask Trybit support for this. NEVER commit the real value.
TRYBIT_WEBHOOK_PUBLIC_KEY=

# ---------- Pricing (USD, server-side) ----------
PRO_PRICE=10
MIN_TOPUP=10
MAX_TOPUP=500